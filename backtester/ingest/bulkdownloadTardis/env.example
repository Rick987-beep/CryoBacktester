# Copy to /apps/tardis-archive/.env on the apps server (never commit).

TARDIS_API_KEY=

# Hetzner Storage Box BX21 (5 TB) — Deribit phase 1 (~2.9 TB)
STORAGE_BOX_HOST=uXXXX.your-storagebox.de
STORAGE_BOX_USER=uXXXX
STORAGE_BOX_BASE=tardis_raw
STORAGE_BOX_PORT=23
STORAGE_BOX_SSH_KEY=/root/.ssh/id_ed25519
# Samba/CIFS (not used by archive_fetch): //uXXXX.your-storagebox.de/backup
