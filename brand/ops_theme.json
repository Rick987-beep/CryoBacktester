{
  "pack_id": "cryo_aureas",
  "ux_id": "ops",
  "density": "dense",
  "shell": "dark-ops",
  "product_accent_role": "badge_icon_only",
  "widgets": [
    "nav",
    "badge",
    "meta_pill",
    "kill_control",
    "log_viewer",
