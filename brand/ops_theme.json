    "slot_card",
    "metric_chip"
  ],
  "colors": {
    "page": "#0d1b2a",
    "panel": "#1a2e44",
    "gold": "#c8a84b",
    "blue": "#1e6fbf",
    "muted": "#8a9ab0",
    "border": "#263347",
    "product": {
      "backtester": "#3d7a6a",
      "trader": "#b05a48",
      "quant": "#1e6fbf",
      "execute": "#5c5f8a"
