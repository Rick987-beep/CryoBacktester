#!/bin/bash
# CryoBacktester.app launcher — starts the native pywebview desktop UI.
#
# Layout assumption (default):
#   <repo>/scripts/macos/CryoBacktester.app/Contents/MacOS/CryoBacktester
# so repo root is four levels above this script.
#
# Override repo root when the .app is copied/symlinked elsewhere:
#   export CRYOBT_ROOT=/path/to/CryoBacktester
#
# Exit codes:
#   1 — CRYOBT_ROOT / .venv missing or unusable
#   otherwise — exit status of python -m backtester.ui.desktop

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ -n "${CRYOBT_ROOT:-}" ]]; then
  REPO_ROOT="$(cd "$CRYOBT_ROOT" && pwd)"
else
  # .../scripts/macos/CryoBacktester.app/Contents/MacOS -> repo root (5 levels up)
  REPO_ROOT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
fi

VENV_PY="$REPO_ROOT/.venv/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
  osascript -e "display alert \"CryoBacktester\" message \"Missing virtualenv at:\n$VENV_PY\n\nCreate it with:\n  cd $REPO_ROOT && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt\" as critical" >/dev/null 2>&1 || true
  echo "error: missing executable $VENV_PY" >&2
  echo "hint: set CRYOBT_ROOT if the .app is not under scripts/macos/" >&2
  exit 1
fi

cd "$REPO_ROOT"
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_PY" -m backtester.ui.desktop "$@"
