# CryoBacktester Demo — optional path overrides
# Copy to .env if you need custom data locations.
# .env is gitignored and never committed.

# CRYOBT_MARKET_DATA=/absolute/path/to/data/market
# CRYOBT_RUNS=/absolute/path/to/data/runs
# CRYOBT_JOBS=/absolute/path/to/data/jobs

# Recorder sync (optional — not required for the bundled demo data):
# RECORDER_VPS_HOST=user@your-recorder-host
# RECORDER_VPS_DATA_DIR=/path/to/recorder/data
# SSH_KEY=~/.ssh/id_ed25519
